import std.prelude.Show
import std.io

export Error, Stderr, stderr, write, flush, print

type Error = { BrokenPipe, Interrupted, Other(Str) }
extern type Stderr

extern "std/io/err" as err_shim = {
  fn stderr() => Stderr
  fn write(writer: Stderr, value: Str) => Result[Unit, Error]
  fn flush(writer: Stderr) => Result[Unit, Error]
}

fn stderr() => Stderr = err_shim.stderr()

impl io.Write[Stderr, Error] = {
  fn write(writer: Stderr, value: Str) => Result[Unit, Error] = err_shim.write(writer, value)

  fn flush(writer: Stderr) => Result[Unit, Error] = err_shim.flush(writer)
}

fn write(value: Str) => Result[Unit, Error] = io.Write.write(stderr(), value)

fn flush() => Result[Unit, Error] = io.Write.flush(stderr())

fn print[a: Show](value: a) => Result[Unit, Error] = io.Write.print(stderr(), Show.show(value))
