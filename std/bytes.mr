export Bytes, DecodeError, Decode, Encode, from_str, to_str, to_str_lossy, length, equal?

extern type Bytes

type DecodeError = { InvalidUtf8 }

extern "std/bytes" as byte_shim = {
  fn from_str(input: Str) -> Bytes
  fn to_str(input: Bytes) -> Result[Str, DecodeError]
  fn to_str_lossy(input: Bytes) -> Str
  fn length(input: Bytes) -> Int
  fn equal?(left: Bytes, right: Bytes) -> Bool
}

trait Decode[a] = {
  fn decode(input: Bytes) -> Result[a, DecodeError]
}

trait Encode[a] = {
  fn encode(input: a) -> Bytes
}

impl Decode[Bytes] = {
  fn decode(input: Bytes) -> Result[Bytes, DecodeError] =
    if (true) {
      Result.Success(input)
    } else {
      Result.Failure(DecodeError.InvalidUtf8)
    }
}

impl Encode[Bytes] = {
  fn encode(input: Bytes) -> Bytes = input
}

impl Decode[Str] = {
  fn decode(input: Bytes) -> Result[Str, DecodeError] = byte_shim.to_str(input)
}

impl Encode[Str] = {
  fn encode(input: Str) -> Bytes = byte_shim.from_str(input)
}
