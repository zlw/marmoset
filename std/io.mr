import std.prelude.Show

export Error, Stdin, Stdout, Read, Write, stdin, stdout, read, write, flush, print

type Error = { EndOfFile, BrokenPipe, Interrupted, Other(Str) }
extern type Stdin
extern type Stdout

trait Read[r, e] = {
  fn read(reader: r) => Result[Str, e]
}

trait Write[w, e] = {
  fn write(writer: w, value: Str) => Result[Unit, e]
  fn flush(writer: w) => Result[Unit, e]

  fn print[a: Show](writer: w, value: a) => Result[Unit, e] = match Write.write(writer, Show.show(value) + "\n") {
    case Result.Success(_): Write.flush(writer)
    case Result.Failure(err): Result.Failure(err)
  }
}

extern "std/io" as io_shim = {
  fn stdin() => Stdin
  fn stdout() => Stdout
  fn read() => Result[Str, Error]
  fn write(value: Str) => Result[Unit, Error]
  fn flush() => Result[Unit, Error]
}

fn stdin() => Stdin = io_shim.stdin()

fn stdout() => Stdout = io_shim.stdout()

impl Read[Stdin, Error] = {
  fn read(_reader: Stdin) => Result[Str, Error] = io_shim.read()
}

impl Write[Stdout, Error] = {
  fn write(_writer: Stdout, value: Str) => Result[Unit, Error] = io_shim.write(value)

  fn flush(_writer: Stdout) => Result[Unit, Error] = io_shim.flush()
}

fn read() => Result[Str, Error] = Read.read(stdin())

fn write(value: Str) => Result[Unit, Error] = Write.write(stdout(), value)

fn flush() => Result[Unit, Error] = Write.flush(stdout())

fn print[a: Show](value: a) => Result[Unit, Error] = Write.print(stdout(), Show.show(value))
