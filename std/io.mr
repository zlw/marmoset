import std.prelude.Show

export Error, Read, Write, read, write, print, puts, flush

type Error = {
  EndOfFile   = "Input ended",
  BrokenPipe  = "Pipe is broken",
  Interrupted = "I/O operation was interrupted",
  Other(Str)  = "I/O operation failed",
}

extern type Stdin
extern type Stdout

trait Read[r, e] = {
  fn read(reader: r) => Result[Str, e]
}

trait Write[w, e] = {
  fn write(writer: w, value: Str) => Result[Unit, e]
  fn flush(writer: w) => Result[Unit, e]

  fn print[a: Show](writer: w, value: a) => Result[Unit, e] =
    Write.write(writer, "#{value}")

  fn puts[a: Show](writer: w, value: a) => Result[Unit, e] =
    Write.write(writer, "#{value}\n")
}

extern "std/io" as io_shim = {
  fn read(reader: Stdin) => Result[Str, Error]
  fn write(writer: Stdout, value: Str) => Result[Unit, Error]
  fn flush(writer: Stdout) => Result[Unit, Error]
}

impl Read[Stdin, Error] = {
  fn read(reader: Stdin) => Result[Str, Error] = io_shim.read(reader)
}

impl Write[Stdout, Error] = {
  fn write(writer: Stdout, value: Str) => Result[Unit, Error] = io_shim.write(writer, value)
  fn flush(writer: Stdout) => Result[Unit, Error] = io_shim.flush(writer)
}

fn read() => Result[Str, Error] = Read.read(Stdin)
fn write(value: Str) => Result[Unit, Error] = Write.write(Stdout, value)
fn print[a: Show](value: a) => Result[Unit, Error] = Write.print(Stdout, value)
fn puts[a: Show](value: a) => Result[Unit, Error] = Write.puts(Stdout, value)
fn flush() => Result[Unit, Error] = Write.flush(Stdout)
