import std.bytes
import std.bytes.Bytes
import std.io

export FileReadError, FileWriteError,
       FileOpenError, FileCloseError, FileUseError,
       read, read_bytes, write, write_bytes, read_all, open

extern type File
type Path = Path(Str)

type FileReadError = { NotFound, PermissionDenied, IsDirectory, AlreadyClosed, Other(Str) }
type FileWriteError = { NotFound, PermissionDenied, IsDirectory, Other(Str) }
type FileOpenError = { NotFound, PermissionDenied, IsDirectory, Other(Str) }
type FileCloseError = { AlreadyClosed, Other(Str) }
type FileUseError[e] = { Open(FileOpenError), Use(e), Close(FileCloseError), UseAndClose(e, FileCloseError) }

extern "std/file" as file_shim = {
  fn read_bytes(path: Str) => Result[Bytes, FileReadError]
  fn write_bytes(path: Str, bytes: Bytes) => Result[Unit, FileWriteError]
  fn flush_path(path: Str) => Result[Unit, FileWriteError]
  fn read_all(file: File) => Result[Bytes, FileReadError]
  fn open_handle(path: Str) => Result[File, FileOpenError]
  fn close_handle(file: File) => Result[Unit, FileCloseError]
}

impl io.Read[File, FileReadError] = {
  fn read(file: File) => Result[Str, FileReadError] = match file_shim.read_all(file) {
    case Result.Success(payload): Result.Success(bytes.to_str_lossy(payload))
    case Result.Failure(err): Result.Failure(err)
  }
}

impl io.Read[Path, FileReadError] = {
  fn read(path: Path) => Result[Str, FileReadError] = match path {
    case Path(value): match file_shim.read_bytes(value) {
      case Result.Success(payload): Result.Success(bytes.to_str_lossy(payload))
      case Result.Failure(err): Result.Failure(err)
    }
  }
}

impl io.Write[Path, FileWriteError] = {
  fn write(path: Path, value: Str) => Result[Unit, FileWriteError] = match path {
    case Path(target): file_shim.write_bytes(target, bytes.from_str(value))
  }

  fn flush(path: Path) => Result[Unit, FileWriteError] = match path {
    case Path(target): file_shim.flush_path(target)
  }
}

fn read(path: Str) => Result[Str, FileReadError] = io.Read.read(Path(path))

fn write(path: Str, value: Str) => Result[Unit, FileWriteError] = io.Write.write(Path(path), value)

fn open[a, e](path: Str, body: (File) => Result[a, e]) => Result[a, FileUseError[e]] = match file_shim.open_handle(path) {
  case Result.Failure(err): Result.Failure(FileUseError.Open(err))
  case Result.Success(file): {
    let body_result = body(file)
    match file_shim.close_handle(file) {
      case Result.Success(_): match body_result {
        case Result.Success(value): Result.Success(value)
        case Result.Failure(err): Result.Failure(FileUseError.Use(err))
      }
      case Result.Failure(close_err): match body_result {
        case Result.Success(_): Result.Failure(FileUseError.Close(close_err))
        case Result.Failure(err): Result.Failure(FileUseError.UseAndClose(err, close_err))
      }
    }
  }
}
