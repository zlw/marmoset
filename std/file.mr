import std.bytes
import std.bytes.Bytes
import std.bytes.Decode
import std.bytes.DecodeError
import std.bytes.Encode
import std.io
import std.path
import std.path.PathLike

export File, Mode, Error, UseError, read, write, append, open, read_all, write_all, flush

extern type File

type Mode = { Read, Write, Append }

type Error = {
  NotFound,
  PermissionDenied,
  AlreadyExists,
  IsDirectory,
  NotDirectory,
  InvalidPath(Str),
  InvalidData(Str),
  AlreadyClosed,
  Other(Str),
}

type UseError[e] = { Open(Error), Use(e), Close(Error), UseAndClose(e, Error) }

extern "std/file" as file_shim = {
  fn read_data(path: Str) => Result[Bytes, Error]
  fn write_data(path: Str, bytes: Bytes) => Result[Unit, Error]
  fn append_data(path: Str, bytes: Bytes) => Result[Unit, Error]
  fn open_handle(path: Str, mode: Mode) => Result[File, Error]
  fn close_handle(file: File) => Result[Unit, Error]
  fn read_all_data(file: File) => Result[Bytes, Error]
  fn write_all_data(file: File, bytes: Bytes) => Result[Unit, Error]
  fn flush_handle(file: File) => Result[Unit, Error]
}

fn path_value[p: PathLike](value: p) -> Str =
  path.to_str(path.PathLike.path(value))

fn decode_error(err: DecodeError) -> Error = match err {
  case DecodeError.InvalidUtf8: Error.InvalidData("invalid utf-8")
}

fn decode_bytes[a: Decode](payload: Bytes) -> Result[a, Error] =
  {
    let decoded: Result[a, DecodeError] = bytes.Decode.decode(payload)
    match decoded {
    case Result.Success(value): Result.Success(value)
    case Result.Failure(err): Result.Failure(decode_error(err))
    }
  }

fn read[a: Decode, p: PathLike](path: p) => Result[a, Error] =
  match file_shim.read_data(path_value(path)) {
    case Result.Success(payload): decode_bytes(payload)
    case Result.Failure(err): Result.Failure(err)
  }

fn write[a: Encode, p: PathLike](path: p, value: a) => Result[Unit, Error] =
  file_shim.write_data(path_value(path), bytes.Encode.encode(value))

fn append[a: Encode, p: PathLike](path: p, value: a) => Result[Unit, Error] =
  file_shim.append_data(path_value(path), bytes.Encode.encode(value))

fn read_all[a: Decode](file: File) => Result[a, Error] =
  match file_shim.read_all_data(file) {
    case Result.Success(payload): decode_bytes(payload)
    case Result.Failure(err): Result.Failure(err)
  }

fn write_all[a: Encode](file: File, value: a) => Result[Unit, Error] =
  file_shim.write_all_data(file, bytes.Encode.encode(value))

fn flush(file: File) => Result[Unit, Error] =
  file_shim.flush_handle(file)

impl io.Read[File, Error] = {
  fn read(file: File) => Result[Str, Error] = {
    let result: Result[Str, Error] = read_all(file)
    result
  }
}

impl io.Write[File, Error] = {
  fn write(file: File, value: Str) => Result[Unit, Error] =
    write_all(file, value)

  fn flush(file: File) => Result[Unit, Error] =
    file_shim.flush_handle(file)
}

fn open[p: PathLike, a, e](path: p, mode: Mode, body: (File) => Result[a, e]) => Result[a, UseError[e]] =
  match file_shim.open_handle(path_value(path), mode) {
    case Result.Failure(err): Result.Failure(UseError.Open(err))
    case Result.Success(file): {
      let body_result = body(file)
      match file_shim.close_handle(file) {
        case Result.Success(_): match body_result {
          case Result.Success(value): Result.Success(value)
          case Result.Failure(err): Result.Failure(UseError.Use(err))
        }
        case Result.Failure(close_err): match body_result {
          case Result.Success(_): Result.Failure(UseError.Close(close_err))
          case Result.Failure(err): Result.Failure(UseError.UseAndClose(err, close_err))
        }
      }
    }
  }
