import std.io
import std.error

fn hello_world() => Result[Unit, io.Error] = {
  io.print("What's your name?")
  |> Result.bind((_) => io.read())
  |> Result.map("Hello, #{_}")
  |> Result.bind(io.print)
}

match hello_world() {
  case Result.Success(_): true
  case Result.Failure(err): {
    puts(error.message(err))
    false
  }
}
