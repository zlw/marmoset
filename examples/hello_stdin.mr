import std.io

fn ask_name() => Result[Unit, io.Error] =
  io.print("What's your name?")

fn get_name(_: Unit) => Result[Str, io.Error] =
  io.read()

fn say_name(name: Str) => Result[Unit, io.Error] =
  io.print("Hello, #{name}")

fn hello_world() => Result[Unit, io.Error] = {
  ask_name()
  |> Result.bind(get_name)
  |> Result.bind(say_name)
}

hello_world()
