	mshim_std_bytes "marmoset_out/shims/std/bytes"
	"strconv"
)

func extern__std_basics__puts_str(value string) struct{} {
	defer func() {
		if __panic := recover(); __panic != nil {
			panic(fmt.Sprintf("shim ABI violation at std/basics.puts_str: %v", __panic))
		}
	}()
	mshim_std_basics.PutsStr(value)
	return struct{}{}
}

func extern__std_bytes__equal_q(left marmoset.Bytes, right marmoset.Bytes) bool {
	defer func() {
		if __panic := recover(); __panic != nil {
			panic(fmt.Sprintf("shim ABI violation at std/bytes.equal?: %v", __panic))
		}
	}()
	__ret := mshim_std_bytes.EqualQ(marmoset.BytesCopy(left.Copy()), marmoset.BytesCopy(right.Copy()))
	return __ret
}

