	defer func() {
		if __panic := recover(); __panic != nil {
			panic(fmt.Sprintf("shim ABI violation at std/bytes.from_str: %v", __panic))
		}
	}()
	__ret := mshim_std_bytes.FromStr(input)
	return marmoset.BytesCopy(__ret.Copy())
}

