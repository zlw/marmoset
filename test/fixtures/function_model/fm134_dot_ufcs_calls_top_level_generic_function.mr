# FM134: explicit top-level generic function call
fn map[a](arr: List[a], f: (a) -> a) -> List[a] = {
  let iter = (arr: List[a], accumulated: List[a]) -> {
    if (len(arr) == 0) {
      accumulated
    } else {
      iter(rest(arr), push(accumulated, f(first(arr))))
    }
  }

  iter(arr, [])
}

fn show_int_list_items(items: List[Int]) -> Str = {
  if (len(items) == 0) {
    ""
  } else {
    if (len(rest(items)) == 0) {
      Show.show(first(items))
    } else {
      Show.show(first(items)) + " " + show_int_list_items(rest(items))
    }
  }
}

impl Show[List[Int]] = {
  fn show(items: List[Int]) -> Str = "[" + show_int_list_items(items) + "]"
}

let numbers = [1, 2, 3]
puts(map(numbers, (x: Int) -> x * 2))  # output: [2 4 6]
