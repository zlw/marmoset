# R023: Derive ord for record
type Point = { x: Int, y: Int } derive Eq, Ord
fn show_ordering(ordering: Ordering) -> Str = match ordering {
  case Ordering.Less: "Less"
  case Ordering.Equal: "Equal"
  case Ordering.Greater: "Greater"
}
let p1: Point = {x: 1, y: 2}
let p2: Point = {x: 1, y: 3}
puts(show_ordering(Ord.compare(p1, p2)))  # output: Less
